{
  "version": 1,
  "defaultProfile": "core",
  "aliases": {
    "minimal": "core",
    "smart": "core",
    "all": "full"
  },
  "profiles": {
    "core": {
      "description": "Low-noise runtime for bounded implementation and verification.",
      "agents": [
        "architect",
        "build-error-resolver",
        "code-reviewer",
        "janitor",
        "planner",
        "refactor-cleaner",
        "scout",
        "sleuth",
        "spark",
        "tdd-guide",
        "tech-lead",
        "verifier"
      ],
      "skills": [
        "build",
        "cli-reference",
        "coding-standards",
        "commit",
        "completion-check",
        "dead-code",
        "debug",
        "explore",
        "factcheck-guard",
        "fix",
        "git-commits",
        "help",
        "modular-code",
        "notepad-system",
        "observe-before-editing",
        "plan-agent",
        "project-detect",
        "refactor",
        "review",
        "search-router",
        "search-tools",
        "security",
        "security-review",
        "strategic-compact",
        "system-overview",
        "tdd",
        "tdd-workflow",
        "test",
        "test-strategy",
        "tour",
        "verification-loop",
        "wiring"
      ],
      "rules": [],
      "hooks": [
        "credential-deny",
        "path-rules",
        "pre-compact-continuity",
        "post-edit-diagnostics",
        "session-end-cleanup",
        "token-tracker"
      ],
      "contextBudget": {
        "perEventChars": 4000,
        "sessionChars": 12000
      }
    },
    "dashboard": {
      "extends": "core",
      "description": "Core runtime plus opt-in local activity monitoring.",
      "hooks": ["dashboard-ws-emitter"]
    },
    "quality": {
      "extends": "core",
      "description": "Core runtime plus focused edit and verification checks.",
      "hooks": [
        "typescript-preflight",
        "compiler-in-the-loop",
        "import-validator",
        "sast-on-edit",
        "impact-refactor",
        "file-claims"
      ]
    },
    "context": {
      "extends": "core",
      "description": "Core runtime plus targeted code context retrieval.",
      "hooks": [
        "tldr-read-enforcer",
        "smart-search-router",
        "tldr-context-inject",
        "arch-context-inject",
        "edit-context-inject",
        "signature-helper"
      ]
    },
    "memory": {
      "extends": "core",
      "description": "Core runtime plus opt-in memory and learning hooks.",
      "hooks": [
        "session-start-recall",
        "instinct-loader",
        "smart-memory-recall",
        "passive-learner",
        "instinct-consolidator",
        "memory-graph"
      ],
      "skills": [
        "learn",
        "recall",
        "recall-reasoning",
        "remember"
      ],
      "agents": ["self-learner"]
    },
    "orchestration": {
      "extends": "core",
      "description": "Core runtime plus explicit multi-agent orchestration.",
      "hooks": [
        "agent-memory-loader",
        "agent-memory-saver",
        "canavar-cross-review",
        "canavar-error-broadcast",
        "canavar-subagent-tracker",
        "subagent-stop-learner",
        "skill-activation-prompt",
        "mcp-discovery"
      ],
      "skills": [
        "agentic-workflow",
        "parallel-agents",
        "workflow-router"
      ],
      "agents": ["maestro", "kraken"]
    },
    "full": {
      "description": "All repository capabilities, including legacy Claude workflows.",
      "agents": "all",
      "skills": "all",
      "rules": "all",
      "hooks": "all",
      "contextBudget": {
        "perEventChars": 8000,
        "sessionChars": 50000
      }
    }
  }
}
